{
  "name": "@zseven-w/dsh-qa",
  "version": "0.1.0-rc.2",
  "description": "QA orchestrator plugin for DeepSeek Harness: an agent explores your app and leaves evidence, then the explored path replays deterministically. Drives the browser, macOS desktop, iOS and Android drivers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZSeven-W/dsh-qa.git"
  },
  "bugs": {
    "url": "https://github.com/ZSeven-W/dsh-qa/issues"
  },
  "homepage": "https://github.com/ZSeven-W/dsh-qa#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qa",
    "browser-use",
    "computer-use",
    "automation",
    "agent"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "scenarios",
    "fixtures/web",
    "skills",
    "cordis.patch.yml",
    ".mcp.json",
    ".claude-plugin",
    "docs",
    "README.*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "mcp": "node src/server.mjs",
    "build": "npm run build:mcp && npm run build:entry",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:entry": "node scripts/build-entry.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.mjs test/*.test.ts",
    "test:ci": "node scripts/run-tests.mjs --exclude-native",
    "smoke:bundle": "node scripts/smoke-bundle.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "example": "node scripts/run-example.mjs",
    "prepack": "npm run build && npm run typecheck && npm test",
    "prepublishOnly": "npm run smoke:pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@zseven-w/dsh-browser": "link:../dsh-browser",
    "@zseven-w/dsh-computer": "link:../dsh-computer",
    "@zseven-w/dsh-android": "link:../dsh-android",
    "@zseven-w/dsh-ios": "link:../dsh-ios",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [
      "global-hook",
      "mcp-server",
      "tool-registration"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dshHostRuntime": {
    "_comment": "Host-provided runtime services. Never declare them as dependencies or peerDependencies: plain `npm i @zseven-w/dsh-qa` must install with zero @deepseek-ai/* packages (enforced by scripts/smoke-pack.mjs). The DSH host supplies these itself.",
    "services": [
      "tools",
      "attachments",
      "llm",
      "approval"
    ],
    "typing": "structural"
  }
}
